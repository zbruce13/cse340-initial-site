
<%- include("partials/header", { title: title }) %>

<main class="page-content">
  <section class="page-intro">
    <p class="eyebrow">PROJECT MANAGEMENT</p>
    <h1>Edit Service Project</h1>
    <p>Update the service opportunity information below.</p>
  </section>

  <% if (errors && errors.length > 0) { %>
    <ul class="error-list">
      <% errors.forEach((error) => { %>
        <li><%= error %></li>
      <% }) %>
    </ul>
  <% } %>

  <form action="/projects/edit/<%= project.project_id %>" method="POST">
    <div class="form-group">
      <label for="project_name">Project Name</label>
      <input
        type="text"
        id="project_name"
        name="project_name"
        maxlength="100"
        required
        value="<%= project.project_name %>"
      >
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        required
      ><%= project.description || "" %></textarea>
    </div>

    <div class="form-group">
      <label for="organization_id">Organization</label>
      <select id="organization_id" name="organization_id" required>
        <option value="">Select an organization</option>
        <% organizations.forEach((organization) => { %>
          <option
            value="<%= organization.organization_id %>"
            <%= String(organization.organization_id) === String(project.organization_id) ? "selected" : "" %>
          >
            <%= organization.organization_name %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="form-group">
      <label for="location">Location</label>
      <input
        type="text"
        id="location"
        name="location"
        maxlength="200"
        value="<%= project.location || "" %>"
      >
    </div>

    <div class="form-group">
      <label for="project_date">Project Date</label>
      <input
        type="date"
        id="project_date"
        name="project_date"
        value="<%= project.project_date ? String(project.project_date).slice(0, 10) : "" %>"
      >
    </div>

    <button type="submit">Save Changes</button>
  </form>

  <p>
    <a href="/projects/<%= project.project_id %>">Back to Project</a>
  </p>
</main>

<%- include("partials/footer") %>
