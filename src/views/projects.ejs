<%- include('partials/header', { title: title }) %>

<main class="page-content">
  <section class="page-intro">
    <p class="eyebrow">Take action</p>
    <h1><%= title %></h1>
    <p>Explore opportunities to serve your community.</p>
  </section>

  <section class="card-grid">
    <% if (projects && projects.length > 0) { %>
      <% projects.forEach((project) => { %>
        <article class="card">
          <h2>
            <a href="/project/<%= project.project_id %>">
              <%= project.project_name %>
            </a>
          </h2>

          <p>
            <%= project.description || "No description available." %>
          </p>

          <p>
            Organization:
            <% if (project.organization_id) { %>
              <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
              </a>
            <% } else { %>
              Unassigned
            <% } %>
          </p>

          <p>
            Location:
            <%= project.location || "Not specified" %>
          </p>

          <p>
            Project Date:
            <%= project.project_date
              ? String(project.project_date).slice(0, 10)
              : "Not specified" %>
          </p>
        </article>
      <% }); %>
    <% } else { %>
      <p>No upcoming projects found.</p>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>