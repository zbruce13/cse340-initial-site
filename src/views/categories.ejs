
<%- include("partials/header", { title: title }) %>

<main class="page-content">
  <section class="page-heading">
    <p class="eyebrow">FIND YOUR PASSION</p>
    <h1><%= title %></h1>
    <p>Explore different ways to make a meaningful difference.</p>

    <p>
      <a href="/new-category" class="button">Add New Category</a>
    </p>
  </section>

  <% if (success_msg && success_msg.length > 0) { %>
    <ul class="success-list">
      <% success_msg.forEach((message) => { %>
        <li><%= message %></li>
      <% }) %>
    </ul>
  <% } %>

  <% if (error_msg && error_msg.length > 0) { %>
    <ul class="error-list">
      <% error_msg.forEach((message) => { %>
        <li><%= message %></li>
      <% }) %>
    </ul>
  <% } %>

  <section class="card-grid">
    <% if (categories && categories.length > 0) { %>
      <% categories.forEach((category, index) => { %>
        <article class="card">
          <p class="eyebrow">
            <%= String(index + 1).padStart(2, "0") %>
          </p>

          <h2>
            <a href="/category/<%= category.category_id %>">
              <%= category.category_name %>
            </a>
          </h2>

          <p>
            <a href="/edit-category/<%= category.category_id %>">
              Edit Category
            </a>
          </p>
        </article>
      <% }); %>
    <% } else { %>
      <p>No categories found.</p>
    <% } %>
  </section>
</main>

<%- include("partials/footer") %>
