<%- include('partials/header', { title: title }) %>

<main class="page-content">
  <section class="page-intro">
    <p class="eyebrow">Working together</p>
    <h1><%= title %></h1>
    <p>Meet our community partners.</p>
  </section>

  <section class="card-grid">
    <% if (organizations && organizations.length > 0) { %>
      <% organizations.forEach((organization) => { %>
        <article class="card">
          <% if (organization.logo_filename) { %>
            <img
              src="/images/<%= organization.logo_filename %>"
              alt="<%= organization.organization_name %> logo"
            >
          <% } %>

          <h2><%= organization.organization_name %></h2>

          <p><%= organization.description || "No description available." %></p>

          <% if (organization.contact_email) { %>
            <p>
              Contact:
              <a href="mailto:<%= organization.contact_email %>">
                <%= organization.contact_email %>
              </a>
            </p>
          <% } %>
        </article>
      <% }); %>
    <% } else { %>
      <p>No organizations found.</p>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>