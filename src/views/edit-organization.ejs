
<%- include("partials/header", { title: title }) %>

<main class="page-content">
  <section class="page-intro">
    <p class="eyebrow">COMMUNITY PARTNERS</p>
    <h1>Edit Organization</h1>
    <p>Update the organization information below.</p>
  </section>

  <% if (errors && errors.length > 0) { %>
    <ul class="error-list">
      <% errors.forEach((error) => { %>
        <li><%= error %></li>
      <% }) %>
    </ul>
  <% } %>

  <form action="/organizations/edit/<%= organization.organization_id %>" method="POST">
    <div class="form-group">
      <label for="organization_name">Organization Name</label>
      <input
        type="text"
        id="organization_name"
        name="organization_name"
        maxlength="100"
        required
        value="<%= organization.organization_name %>"
      >
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
      ><%= organization.description || "" %></textarea>
    </div>

    <div class="form-group">
      <label for="contact_email">Contact Email</label>
      <input
        type="email"
        id="contact_email"
        name="contact_email"
        maxlength="255"
        value="<%= organization.contact_email || "" %>"
      >
    </div>

    <div class="form-group">
      <label for="logo_filename">Logo Filename</label>
      <input
        type="text"
        id="logo_filename"
        name="logo_filename"
        maxlength="255"
        value="<%= organization.logo_filename || "" %>"
      >
    </div>

    <button type="submit">Save Changes</button>
  </form>

  <p><a href="/organizations">Back to Organizations</a></p>
</main>

<%- include("partials/footer") %>
