<%- include('partials/header', { title: title }) %>

<main class="page-content">
  <section class="page-intro">
    <p class="eyebrow">Our community partners</p>
    <h1><%= organization.organization_name %></h1>
    <p><%= organization.description || "No description available." %></p>
  </section>

  <section class="card-grid">
    <article class="card">
      <% if (organization.logo_filename) { %>
        <img
          src="/images/<%= organization.logo_filename %>"
          alt="<%= organization.organization_name %> logo"
        >
      <% } %>

      <h2>Contact Information</h2>

      <% if (organization.contact_email) { %>
        <p>
          Email:
          <a href="mailto:<%= organization.contact_email %>">
            <%= organization.contact_email %>
          </a>
        </p>
      <% } %>
    </article>
  </section>

  <section class="page-intro">
    <h2>Service Projects</h2>
  </section>

  <section class="card-grid">
    <% if (projects && projects.length > 0) { %>
      <% projects.forEach((project) => { %>
        <article class="card">
          <h3>
            <a href="/project/<%= project.project_id %>">
              <%= project.project_name %>
            </a>
          </h3>

          <p><%= project.description || "No description available." %></p>
          <p>Location: <%= project.location || "Not specified" %></p>
          <p>
            Date:
            <%= project.project_date
              ? String(project.project_date).slice(0, 10)
              : "Not specified" %>
          </p>
        </article>
      <% }); %>
    <% } else { %>
      <p>No projects found for this organization.</p>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>